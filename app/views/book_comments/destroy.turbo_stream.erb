<%= turbo_stream.replace "book_comments_#{@book_comment.book.id}" do %>
  <%= turbo_frame_tag "book_comments_#{@book_comment.book.id}" do %>
    <% @book_comment.book.book_comments.each do |c| %>
      <p><%= c.user.name %>: <%= c.body %></p>
      <% if c.user == Current.user %>
        <%= link_to "Destroy", book_comment_path(c.id), data: { turbo_method: :delete }, class: "btn btn-outline-danger" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>