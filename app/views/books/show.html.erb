<div class="container">
  <div class="row">
    <%= render "shared/sidebar", sidebar_user: @book.user %>

    <div class="col-md-8 offset-md-1">
      <h1>Book detail</h1>
      <p><%= link_to @book.user.name, user_path(@book.user) %></p>
      <h2><%= @book.title %></h2>
      <p><%= @book.body %></p>

      <% if @book.user == Current.user %>
        <%= link_to "Edit", edit_book_path(@book), class: "btn btn-outline-secondary" %>
        <%= link_to "Destroy", book_path(@book), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-outline-danger" %>
      <% end %>
      <% if Current.user.favorites.exists?(book_id: @book.id) %>
        <%= link_to "外す", favorite_path(Current.user.favorites.find_by(book_id: @book.id).id), data: { turbo_method: :delete }, class: "btn btn-outline-danger btn-sm" %>
      <% else %>
        <%= link_to "いいね", favorites_path(book_id: @book.id), data: { turbo_method: :post }, class: "btn btn-outline-danger btn-sm" %>
      <% end %>
      <p> いいね: <%= @book.favorites.count %></p>
      <% @book.book_comments.each do |c| %>
        <p><%= c.user.name %>: <%= c.body %></p>
        <% if c.user == Current.user %>
          <%= link_to "Destroy", book_comment_path(c.id), data: { turbo_method: :delete }, class: "btn btn-outline-danger" %>
        <% end %>
      <% end %>
      <%= form_with url: book_comments_path do |f| %>
        <%= f.text_field :body %>
        <%= f.hidden_field :book_id, value: @book.id %> 
        <%= f.submit class: "btn btn-success" %> 
      <% end %>
      <p> コメント: <%= @book.book_comments.count %></p>
    </div>
  </div>
</div>