<div class="container">
  <div class="row">
    <%= render "shared/sidebar", sidebar_user: Current.user %>

    <div class="col-md-8 offset-md-1">
      <h2>Books</h2>
      <table class="table table-hover">
        <thead>
          <tr>
            <th></th>
            <th>Title</th>
            <th>Opinion</th>
            <th colspan="3"></th>
            <th>いいね</th>
            <th>コメント</th>
          </tr>
        </thead>
        <tbody>
          <% @books.each do |b| %>
            <tr>
              <td><%= link_to "", user_path(b.user) %></td>
              <td><%= link_to b.title, book_path(b) %></td>
              <td><%= truncate(b.body, length: 30) %></td>
              <td>
                <% if b.user == Current.user %>
                  <%= link_to "Edit", edit_book_path(b), class: "btn btn-outline-secondary btn-sm" %>
                <% end %>
              </td>
              <td>
                <% if b.user == Current.user %>
                  <%= link_to "Destroy", book_path(b), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-outline-danger btn-sm" %>
                <% end %>
              </td>
              <td>
                <% if Current.user.favorites.exists?(book_id: b.id) %>
                  <%= link_to "外す", favorite_path(Current.user.favorites.find_by(book_id: b.id).id), data: { turbo_method: :delete }, class: "btn btn-outline-danger btn-sm" %>
                <% else %>
                  <%= link_to "いいね", favorites_path(book_id: b.id), data: { turbo_method: :post }, class: "btn btn-outline-danger btn-sm" %>
                <% end %>
              </td>
              <td><%= b.favorites.count %></td>
              <td><%= b.book_comments.count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>