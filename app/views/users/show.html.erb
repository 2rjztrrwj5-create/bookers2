<div class="container">
  <div class="row">
    <%= render "shared/sidebar", sidebar_user: @user %>

    <div class="col-md-8 offset-md-1">
      <h2>Books</h2>
      <p>コメント: <%= @user.book_comments.count %></p>
      <table class="table table-hover">
        <thead>
          <tr>
            <th></th>
            <th>Title</th>
            <th>Opinion</th>
          </tr>
        </thead>
        <tbody>
          <% @user.books.each do |b| %>
            <tr>
              <td><%= link_to "", user_path(@user) %></td>
              <td><%= link_to b.title, book_path(b) %></td>
              <td><%= truncate(b.body, length: 30) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>