<div class="container">
  <div class="row">
    <%= render "shared/sidebar", sidebar_user: Current.user %>

    <div class="col-md-8 offset-md-1">
      <h1>Following</h1>
      <table class="table table-hover">
        <thead>
          <tr>
            <th></th>
            <th>Name</th>
            <th></th>
            <th>フォロー</th>
            <th>フォロワー</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |u| %>
            <tr>
              <td>
                <%= link_to user_path(u) do %>
                  <% if u.profile_image.attached? %>
                    <%= image_tag u.profile_image, style: "width:40px; height:40px; object-fit:cover; border-radius:50%;" %>
                  <% else %>
                    <%= image_tag "default-image.svg", style: "width:40px; height:40px; object-fit:cover; border-radius:50%;" %>
                  <% end %>
                <% end %>
              </td>
              <td><%= u.name %></td>
              <td><%= link_to "Show", user_path(u), class: "btn btn-outline-secondary btn-sm" %></td>
              <td><%= u.following.count %></td>
              <td><%= u.followers.count %></td>
              <td>
                <% if u != Current.user %>
                  <% if Current.user.active_relationships.exists?(followed_id: u.id) %>
                    <%= link_to "フォロー中", relationship_path(Current.user.active_relationships.find_by(followed_id: u.id).id), data: { turbo_method: :delete }, class: "btn btn-outline-danger btn-sm" %>
                  <% else %>
                    <%= link_to "フォロー", relationships_path(followed_id: u.id), data: { turbo_method: :post }, class: "btn btn-outline-danger btn-sm" %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>