<div class="col-md-3">
  <h2>User info</h2>
  <table class="table">
    <tr>
      <td>
        <% if sidebar_user.profile_image.attached? %>
          <%= image_tag sidebar_user.profile_image, style: "width:150px; height:150px; object-fit:cover;" %>
        <% else %>
          <%= image_tag "default-image.svg", style: "width:150px; height:150px; object-fit:cover;" %>
        <% end %>
      </td>
    </tr>
    <tr>
      <th>name</th>
      <th><%= sidebar_user.name %></th>
    </tr>
    <tr>
      <th>introduction</th>
      <th><%= sidebar_user.introduction %></th>
    </tr>
  </table>

  
  
  <p><%= link_to "フォロー: #{sidebar_user.following.count}", following_user_path(sidebar_user) %></p>
  <p><%= link_to "フォロワー: #{sidebar_user.followers.count}", followers_user_path(sidebar_user) %></p>
  <% if sidebar_user != Current.user %>
    <% if Current.user.active_relationships.exists?(followed_id: sidebar_user.id) %>
      <%= link_to "フォロー中", relationship_path(Current.user.active_relationships.find_by(followed_id: sidebar_user.id).id), data: { turbo_method: :delete }, class: "btn btn-outline-danger btn-sm" %>
  <% else %>
      <%= link_to "フォロー", relationships_path(followed_id: sidebar_user.id), data: { turbo_method: :post }, class: "btn btn-outline-danger btn-sm" %>
    <% end %>
  <% end %>

  <div class="row mb-3">
    <%= link_to edit_user_path(sidebar_user), class: "btn btn-outline-secondary btn-block" do %>
      <i class="fa-solid fa-user-gear"></i>
    <% end %>
  </div>

  <% if sidebar_user == Current.user %>
    <h2 class="mt-3">New book</h2>
    <%= render "books/form", book: @new_book || Book.new %>
  <% end %>
</div>